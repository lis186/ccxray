{
  "name": "ccxray",
  "version": "2.5.0-rc.3",
  "description": "X-ray vision for AI agent sessions — a transparent HTTP proxy and dashboard for Claude Code",
  "main": "server/index.js",
  "bin": {
    "ccxray": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server --watch-path=public server/index.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js unit",
    "test:heavy": "node scripts/run-tests.js heavy",
    "test:browser": "node scripts/run-tests.js browser"
  },
  "keywords": [
    "claude",
    "claude-code",
    "proxy",
    "dashboard",
    "anthropic",
    "ai-agent",
    "debugging",
    "observability"
  ],
  "author": "Justin Lee",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lis186/ccxray.git"
  },
  "homepage": "https://github.com/lis186/ccxray",
  "bugs": {
    "url": "https://github.com/lis186/ccxray/issues"
  },
  "files": [
    "server/",
    "public/",
    "shared/",
    "README*.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/export-onboarding.md",
    "docs/agentflow-report.md",
    "docs/usage.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "agent-browser": "github:vercel-labs/agent-browser",
    "puppeteer": "^25.6.0"
  }
}
