#!/usr/bin/env node
'use strict';

// Fake `claude -p` worker: like the real CLI, its system prompt carries
// "Primary working directory: <getcwd>" and it inherits ANTHROPIC_BASE_URL.
const http = require('node:http');

const target = new URL(process.env.ANTHROPIC_BASE_URL + '/v1/messages');
const sid = process.env.GEN_WORKER_SESSION;
const calls = Number(process.env.GEN_CALLS || 2);
const post = i => new Promise((resolve, reject) => {
  const body = Buffer.from(JSON.stringify({ model: 'claude-sonnet-4', max_tokens: 64,
    system: [{ type: 'text', text: 'You are Claude Code.\nPrimary working directory: ' + process.cwd() }],
    tools: [{ name: 'Bash', description: 'x', input_schema: { type: 'object' } }],
    messages: [{ role: 'user', content: 'worker ' + i }], metadata: { user_id: JSON.stringify({ session_id: sid }) } }));
  const req = http.request({ host: target.hostname, port: target.port, path: target.pathname, method: 'POST',
    headers: { 'content-type': 'application/json', 'content-length': body.length, 'x-api-key': 'test', 'anthropic-version': '2023-06-01' } },
    res => { res.resume(); res.on('end', () => (res.statusCode === 200 ? resolve() : reject(new Error('status ' + res.statusCode)))); });
  req.on('error', reject);
  req.end(body);
});
(async () => {
  for (let i = 0; i < calls; i++) { await post(i); await new Promise(r => setTimeout(r, 50)); }
  process.stdout.write('claude worker done');
})().catch(e => { console.error(String(e)); process.exit(1); });
